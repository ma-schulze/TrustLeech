/dts-v1/;

/ {
	interrupt-parent = <0x8002>;
	model = "linux,dummy-virt";
	#size-cells = <0x02>;
	#address-cells = <0x02>;
	compatible = "linux,dummy-virt";

	reserved-memory {
		#size-cells = <0x02>;
		#address-cells = <0x02>;
		ranges;
		smem@80000000 {
			reg = <0x00 0x80000000 0x00 0x02000000>;
			no-map;
			device_type = "memory";
		};
	};

	memory@40000000 {
		reg = <0x00 0x40000000 0x00 0x40000000>;
		device_type = "memory";
	};

	memory@82000000 {
