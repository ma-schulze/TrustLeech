		bootargs = "kvm-arm.mode=nested rootwait root=/dev/vda console=ttyAMA0 nokaslr";
		stdout-path = "/pl011@9000000";
		rng-seed = <0xe4690940 0x43b58983 0x784e65ee 0x8122bd8b 0x676df961 0xea6d6bfc 0x7bdc1b1c 0x46a75e6f>;
